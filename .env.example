# ============================================================
# Trip Planner - Environment Variable Template
# Copy this file to .env and fill in your AGENT_SEED and API keys.
# The app starts cleanly without any optional keys (mock data is used).
# ============================================================

# -----------------------------------
# uAgents Core & Agentverse
# -----------------------------------
# Required seed phrase for deterministic agent address generation.
# Keep this fixed: changing it creates a new agent with a different address.
AGENT_SEED=

# Agentverse API Key (User Token)
# Created in Agentverse account settings (Profile -> API Keys at https://agentverse.ai)
AGENTVERSE_API_KEY=

# Local inspector/server port (default: 8000)
AGENT_PORT=8000

# -----------------------------------
# ASI:One
# -----------------------------------
# Required for natural-language intent extraction via ASI:One LLM.
# Without this, the orchestrator runs in offline/mock extraction mode.
ASI1_API_KEY=
ASI1_BASE_URL=https://api.asi1.ai/v1
ASI1_MODEL=asi1-mini

# -----------------------------------
# Geocoding - Nominatim (OpenStreetMap)
# -----------------------------------
# Identification for Nominatim rate limits (e.g. "TripPlanner/1.0 contact@example.com").
# Without this, geocoding falls back to mock data.
NOMINATIM_USER_AGENT=

# -----------------------------------
# Places APIs
# -----------------------------------
# Geoapify (places + geocoding) - https://myprojects.geoapify.com  (free tier)
GEOAPIFY_API_KEY=

# Foursquare Places - https://developer.foursquare.com
FOURSQUARE_API_KEY=

# -----------------------------------
# Routing - OpenRouteService
# -----------------------------------
# https://openrouteservice.org
ORS_API_KEY=

# -----------------------------------
# Weather - OpenWeatherMap
# -----------------------------------
# https://openweathermap.org/api
OPENWEATHER_API_KEY=

# -----------------------------------
# Database & Sessions
# -----------------------------------
# Path to the SQLite cache file (default: data/cache.sqlite)
CACHE_DB=data/cache.sqlite

# Session TTL in seconds (default: 1800 = 30 minutes)
SESSION_TTL_SECONDS=1800

# -----------------------------------
# Runtime switches
# -----------------------------------
# TRIP_OFFLINE=1 disables every network call (used by the test-suite). Leave unset for live data.
# TRIP_OFFLINE=
